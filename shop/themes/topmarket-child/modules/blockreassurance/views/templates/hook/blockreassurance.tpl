{**
 * TopMarket Child Theme - Reassurance Template Override (blockreassurance.tpl)
 * Domitek E-Commerce (1:1 Pasek korzyści TopMarket.pl - ikony USP pod sliderem)
 *}
<div id="block-reassurance" class="topmarket-reassurance">
  <div class="container">
    <div class="usp-items d-flex flex-wrap align-items-center justify-content-around">
      <div class="usp-item">
        <img src="{$urls.theme_assets}img/usp-ikona-1.png" alt="30 dni na zwrot" width="46" height="46" loading="lazy">
        <span>30 dni na zwrot</span>
      </div>
      <div class="usp-item">
        <img src="{$urls.theme_assets}img/usp-ikona-2.png" alt="Darmowa dostawa" width="46" height="46" loading="lazy">
        <span>darmowa dostawa od 2000 zł*</span>
      </div>
      <div class="usp-item">
        <img src="{$urls.theme_assets}img/usp-ikona-3.png" alt="Wysyłka dzisiaj" width="46" height="46" loading="lazy">
        <span>zamów do 18:00 - wysyłka dzisiaj</span>
      </div>
      <div class="usp-item">
        <img src="{$urls.theme_assets}img/usp-ikona-4.png" alt="Opinie klientów" width="46" height="46" loading="lazy">
        <span>opinie klientów: 4.9/5</span>
      </div>
    </div>
  </div>
</div>
